{
  "screens": [
    {
      "device": "desktop",
      "id": "desktop-start",
      "name": "Project picker",
      "root": {
        "children": [
          {
            "id": "start-heading",
            "label": "Codebase Inspector",
            "layout": "column",
            "style": [
              "heading"
            ],
            "text": "Open a git repository to see its map."
          },
          {
            "id": "open-project",
            "layout": "column",
            "style": [
              "card",
              "button"
            ],
            "text": "Open folder or drop a folder here"
          },
          {
            "id": "recent-projects",
            "label": "Recent",
            "layout": "column",
            "style": [
              "list"
            ],
            "text": "{recent projects}"
          },
          {
            "children": [
              {
                "id": "cbi-settings",
                "label": "cbi",
                "layout": "column",
                "style": [
                  "card",
                  "input"
                ],
                "text": "Path to cbi  Save  Choose"
              },
              {
                "id": "editor-settings",
                "label": "Editor",
                "layout": "column",
                "style": [
                  "card",
                  "input"
                ],
                "text": "Editor choice and command template"
              },
              {
                "id": "update-settings",
                "label": "Updates",
                "layout": "column",
                "style": [
                  "card"
                ],
                "text": "Check for updates automatically"
              }
            ],
            "cols": 2,
            "id": "settings",
            "layout": "grid"
          }
        ],
        "component": "app/src/index.html",
        "id": "start-root",
        "layout": "column"
      }
    },
    {
      "device": "desktop",
      "id": "desktop-project",
      "name": "Mapped project",
      "root": {
        "children": [
          {
            "id": "project-topbar",
            "layout": "row",
            "style": [
              "heading"
            ],
            "text": "Projects  {project name}  {path}  {version}  Compare  {scan status}"
          },
          {
            "id": "task-panel",
            "layout": "row",
            "style": [
              "card"
            ],
            "text": "Judgement tasks waiting  {task counts}  Copy instruction"
          },
          {
            "id": "map-stage",
            "layout": "column",
            "style": [
              "canvas"
            ],
            "text": "{architecture viewer}"
          }
        ],
        "component": "app/src/index.html",
        "id": "project-root",
        "layout": "column"
      }
    },
    {
      "device": "desktop",
      "id": "architecture-map",
      "name": "Architecture map",
      "root": {
        "children": [
          {
            "id": "viewer-toolbar",
            "layout": "row",
            "style": [
              "toolbar",
              "input"
            ],
            "text": "{breadcrumbs}  Details  Head Base  Changes  map tests cover results  Search"
          },
          {
            "children": [
              {
                "id": "changes-panel",
                "layout": "column",
                "style": [
                  "list"
                ],
                "text": "{changes}"
              },
              {
                "id": "diagram",
                "layout": "column",
                "style": [
                  "canvas"
                ],
                "text": "{concept map or screen sketch}"
              },
              {
                "id": "details-drawer",
                "layout": "column",
                "style": [
                  "drawer"
                ],
                "text": "{selected node details}"
              }
            ],
            "id": "viewer-main",
            "layout": "row"
          },
          {
            "id": "history-timeline",
            "layout": "column",
            "style": [
              "timeline"
            ],
            "text": "{architecture history timeline}"
          }
        ],
        "component": "src/cbi/viewer/index.html",
        "id": "viewer-root",
        "layout": "column"
      }
    }
  ]
}
