    {
      "id": "core",
      "name": "Core poller",
      "summary": "Runs each source on its own timer and merges the results into one allowlisted snapshot.",
      "children": [
        {
          "id": "core.sources",
          "name": "Sources",
          "summary": "Commands to run and parsers for agents, lanes, quota, processes, tasks and PRs.",
          "files": [
