            "electron/sources.test.ts"
          ]
        },
        {
          "id": "core.poller",
          "name": "Poll scheduler",
          "summary": "Staggered timers that never overlap a source and keep its last good result.",
          "files": [
            "orchestra-core/poller.ts",
            "electron/poller.test.ts"
          ]
        },
        {
          "id": "core.snapshot",
          "name": "Snapshot builder",
